NODE_ENV=development
PORT=3000
DB_HOST=sqlite:
DB_USERNAME=testuser
DB_PASSWORD=testpass
DB_DATABASE=team-management
JWT_SECRET=your-secret-key
CLIENT_ORIGIN=http://localhost:5173
PRESENCE_GRACE_MS=5000
SOCKET_JOIN_LIMIT=20
SOCKET_JOIN_WINDOW_MS=10000
AUTH_MAX_FAILED=30
AUTH_FAILURE_WINDOW_MS=900000
REFRESH_TOKEN_TTL_MS=604800000
REST_RATE_LIMIT=600
REST_RATE_WINDOW_MS=60000
# TRUST_PROXY: unset by default (IP spoofing guard). Set to 1 (proxy hops), "loopback", or a CIDR when behind a trusted reverse proxy. See docs/DEPLOYMENT.md.
# TRUST_PROXY=1
